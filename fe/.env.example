# PRN232ASM - Frontend (copy to .env)
# Vite chỉ expose biến bắt đầu bằng VITE_

# Auth Service API
VITE_API_URL=http://localhost:5001

# Paper Service API (direct — hoặc qua Gateway :5000 khi có)
VITE_PAPER_API_URL=http://localhost:5002

# Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

VITE_APP_NAME=Scientific Paper Trend Tracker
