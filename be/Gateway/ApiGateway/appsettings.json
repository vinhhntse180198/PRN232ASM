{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "papers-route": {
        "ClusterId": "paper-cluster",
        "Match": { "Path": "/api/papers/{**catch-all}" }
      },
      "journals-route": {
        "ClusterId": "paper-cluster",
        "Match": { "Path": "/api/journals/{**catch-all}" }
      },
      "authors-route": {
        "ClusterId": "paper-cluster",
        "Match": { "Path": "/api/authors/{**catch-all}" }
      },
      "keywords-route": {
        "ClusterId": "paper-cluster",
        "Match": { "Path": "/api/keywords/{**catch-all}" }
      },
      "topics-route": {
        "ClusterId": "paper-cluster",
        "Match": { "Path": "/api/topics/{**catch-all}" }
      },
      "bookmarks-route": {
        "ClusterId": "paper-cluster",
        "Match": { "Path": "/api/bookmarks/{**catch-all}" }
      },
      "trends-route": {
        "ClusterId": "trend-cluster",
        "Match": { "Path": "/api/trends/{**catch-all}" }
      },
      "dashboard-route": {
        "ClusterId": "trend-cluster",
        "Match": { "Path": "/api/dashboard/{**catch-all}" }
      },
      "reports-route": {
        "ClusterId": "trend-cluster",
        "Match": { "Path": "/api/reports/{**catch-all}" }
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "follows-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/follows/{**catch-all}" }
      },
      "sync-route": {
        "ClusterId": "sync-cluster",
        "Match": { "Path": "/api/sync/{**catch-all}" }
      },
      "datasources-route": {
        "ClusterId": "sync-cluster",
        "Match": { "Path": "/api/datasources/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": { "Address": "http://localhost:5001" }
        }
      },
      "paper-cluster": {
        "Destinations": {
          "paper": { "Address": "http://localhost:5002" }
        }
      },
      "trend-cluster": {
        "Destinations": {
          "trend": { "Address": "http://localhost:5003" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification": { "Address": "http://localhost:5004" }
        }
      },
      "sync-cluster": {
        "Destinations": {
          "sync": { "Address": "http://localhost:5005" }
        }
      }
    }
  }
}
