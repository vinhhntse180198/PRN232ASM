{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "papers-route": {
        "ClusterId": "paper-cluster",
        "Match": { "Path": "/api/papers/{**catch-all}" }
      },
      "authors-route": {
        "ClusterId": "paper-cluster",
        "Match": { "Path": "/api/authors/{**catch-all}" }
      },
      "journals-route": {
        "ClusterId": "paper-cluster",
        "Match": { "Path": "/api/journals/{**catch-all}" }
      },
      "keywords-route": {
        "ClusterId": "paper-cluster",
        "Match": { "Path": "/api/keywords/{**catch-all}" }
      },
      "topics-route": {
        "ClusterId": "paper-cluster",
        "Match": { "Path": "/api/topics/{**catch-all}" }
      },
      "bookmarks-route": {
        "ClusterId": "paper-cluster",
        "Match": { "Path": "/api/bookmarks/{**catch-all}" }
      },
      "trends-route": {
        "ClusterId": "trend-cluster",
        "Match": { "Path": "/api/trends/{**catch-all}" }
      },
      "analytics-route": {
        "ClusterId": "trend-cluster",
        "Match": { "Path": "/api/analytics/{**catch-all}" }
      },
      "dashboard-route": {
        "ClusterId": "trend-cluster",
        "Match": { "Path": "/api/dashboard/{**catch-all}" }
      },
      "reports-route": {
        "ClusterId": "trend-cluster",
        "Match": { "Path": "/api/reports/{**catch-all}" }
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "follows-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/follows/{**catch-all}" }
      },
      "sync-route": {
        "ClusterId": "sync-cluster",
        "Match": { "Path": "/api/sync/{**catch-all}" }
      },
      "datasources-route": {
        "ClusterId": "sync-cluster",
        "Match": { "Path": "/api/datasources/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": { "Address": "http://auth-service:8080" }
        }
      },
      "paper-cluster": {
        "Destinations": {
          "paper": { "Address": "http://paper-service:8080" }
        }
      },
      "trend-cluster": {
        "Destinations": {
          "trend": { "Address": "http://trend-service:8080" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification": { "Address": "http://notification-service:8080" }
        }
      },
      "sync-cluster": {
        "Destinations": {
          "sync": { "Address": "http://sync-service:8080" }
        }
      }
    }
  }
}
